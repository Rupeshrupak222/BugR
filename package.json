{
  "name": "bug-refinery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --target node24 --ssr src/render.tsx --outDir .render && node .render/render.js",
