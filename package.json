    "test": "node --test",
    "test:browser": "playwright test"
  },
  "dependencies": {"express":"^5.1.0","react":"^19.1.0","react-dom":"^19.1.0"},
  "devDependencies": {"@playwright/test":"^1.51.0","@tailwindcss/vite":"^4.1.0","@types/node":"^22.0.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","tailwindcss":"^4.1.0","typescript":"^5.8.0","vite":"^6.3.0"}
}
