{
  "name": "bug-refinery-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "pnpm --recursive run build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "start": "pnpm --filter frontend start",
    "start:backend": "pnpm --filter backend start:prod",
    "test": "pnpm --recursive run test",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "lint": "pnpm --recursive run lint",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
